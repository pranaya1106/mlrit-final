# Groq API key used for the LLM (llama-3.1-8b-instant)
GROQ_API_KEY=your_groq_api_key_here

# ChromaDB persistence directory (vector store)
CHROMA_PERSIST_DIR=./chroma_db

# Directory containing department PDFs to index
PDF_DIR=./pdfs

# Optional: override auto-derived paths
# BM25_INDEX_PATH=./chroma_db/bm25_index.pkl
# INDEX_MANIFEST_PATH=./chroma_db/index_manifest.json
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Server
HOST=0.0.0.0
PORT=8001

# Comma-separated list of allowed origins, or * for all.
# "*" is fine for local development only — set this to the real frontend
# origin(s) before deploying (e.g. https://mlrit.ac.in,https://www.mlrit.ac.in).
# Wildcard origins cannot receive credentialed requests (see main.py) — this
# frontend doesn't send any, so it's not a functional issue, but an explicit
# origin is still required for real CORS protection in production.
CORS_ORIGINS=*
