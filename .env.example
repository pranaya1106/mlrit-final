# URL of the chatbot backend (FastAPI service in ./chatbot)
# Point this at your deployed backend URL in production — required, or the
# chatbot widget silently tries to reach every visitor's own machine instead.
NEXT_PUBLIC_CHATBOT_URL=http://127.0.0.1:8001

# URL of the Chronicles/news API — a Cloudflare Worker (mlrit-news-worker,
# see its own repo/deploy) that scrapes Google News + Bing News RSS directly
# and stores results in D1. Required, or the Chronicles page silently shows no
# news. There is no local backend to run instead; point this at the deployed
# Worker even in local dev.
NEWS_API_URL=https://mlrit-news-worker.lingamaditya3669.workers.dev
