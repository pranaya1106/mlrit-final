# URL of the chatbot backend (FastAPI service in ./chatbot)
# Point this at your deployed backend URL in production — required, or the
# chatbot widget silently tries to reach every visitor's own machine instead.
NEXT_PUBLIC_CHATBOT_URL=http://127.0.0.1:8001

# URL of the Chronicles/news API. Local dev only needs this if running the
# backend/ FastAPI scraper directly. In production, point this at the deployed
# Cloudflare Worker — required, or the Chronicles page silently shows no news.
NEWS_API_URL=http://localhost:8000
